{
  "name": "@pionne/web",
  "version": "0.3.6",
  "description": "Error monitoring SDK for the browser \u2014 Pionne. Auto-captures uncaught errors and unhandled rejections, ships client context (UA, viewport, locale), tracks Release Health (crash-free user rate), and exposes a feedback API.",
  "license": "MIT",
  "author": "AGKG Creations",
  "homepage": "https://pionne.agkgcreations.fr",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agkgcreations/pionne-sdk-web.git"
  },
  "bugs": {
    "url": "https://github.com/agkgcreations/pionne-sdk-web/issues"
  },
  "keywords": [
    "pionne",
    "browser",
    "web",
    "react",
    "vue",
    "svelte",
    "error-monitoring",
    "crash-reporting",
    "observability"
  ],
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "browser": "dist/index.mjs",
  "source": "src/index.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "devDependencies": {
    "tsup": "^8.3.0",
    "typescript": "^5.5.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false
}
